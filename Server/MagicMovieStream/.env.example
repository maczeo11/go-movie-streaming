# Server
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# MongoDB
DATABASE_NAME=magicstream
MONGODB_URI=mongodb://127.0.0.1:27017/

# Auth secrets - CHANGE THESE in any real deployment
SECRET_KEY=
SECRET_REFRESH_KEY=

# Comma-separated list of origins the browser client is served from
ALLOWED_ORIGINS=http://localhost:5173

# Where the video files for /media live
MEDIA_DIR=./media

# OpenAI - used by the admin "update review" endpoint to auto-rank reviews
OPENAI_API_KEY=
BASE_PROMPT_TEMPLATE=
RECOMMENDED_MOVIE_LIMIT=5

# Rate limiting (tokens/sec, burst)
API_RATE=2
API_BURST=120
AUTH_RATE=0.1
AUTH_BURST=10
