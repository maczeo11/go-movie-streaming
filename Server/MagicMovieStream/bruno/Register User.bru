meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/user
  body: json
  auth: none
}

body:json {
  {
    "first_name": "John",
    "last_name": "Doe",
    "email": "john.doe{{$randomInt}}@example.com",
    "password": "password123",
    "role": "USER",
    "favourite_genres": [
      {
        "genre_id": 1,
        "genre_name": "Sci-Fi"
      },
      {
        "genre_id": 2,
        "genre_name": "Action"
      }
    ]
  }
}